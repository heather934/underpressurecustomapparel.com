import { useState, useRef } from "react";

const SHIRT_FRONT = "data:image/png;base64,";
const SHIRT_BACK = "data:image/png;base64,";

const COLORS = [
  { name: "White", hex: "#ffffff" },
  { name: "Black", hex: "#1a1a1a" },
  { name: "Hot Pink", hex: "#e91e8c" },
  { name: "Royal Blue", hex: "#1565c0" },
  { name: "Forest Green", hex: "#2e7d32" },
  { name: "Purple", hex: "#6a1b9a" },
  { name: "Red", hex: "#c62828" },
  { name: "Navy", hex: "#0d1b4b" },
  { name: "Teal", hex: "#00695c" },
  { name: "Gold", hex: "#f9a825" },
];

export default function CrewNeckT() {
  const [selectedColor, setSelectedColor] = useState(COLORS[2]);
  const [view, setView] = useState("front");
  const [graphic, setGraphic] = useState(null);
  const fileInputRef = useRef(null);

  const activeShirt = view === "front" ? SHIRT_FRONT : SHIRT_BACK;

  function handleUpload(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => setGraphic(ev.target.result);
    reader.readAsDataURL(file);
  }

  return (
    <div style={{
      minHeight: "100vh",
      background: "#1a1a2e",
      display: "flex",
      flexDirection: "column",
      alignItems: "center",
      justifyContent: "center",
      fontFamily: "'Arial', sans-serif",
      padding: "24px",
    }}>
      <div style={{ textAlign: "center", marginBottom: "24px" }}>
        <h1 style={{
          color: "#fff",
          fontSize: "20px",
          fontWeight: "800",
          letterSpacing: "3px",
          textTransform: "uppercase",
          margin: 0,
        }}>Under Pressure Custom Apparel</h1>
        <p style={{ color: "#aaa", fontSize: "12px", marginTop: "6px", letterSpacing: "1px" }}>
          CREW NECK TEE — COLOR PREVIEW
        </p>
      </div>

      <div style={{
        background: "#f0f0f0",
        borderRadius: "20px",
        padding: "32px 28px",
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        gap: "20px",
        boxShadow: "0 24px 64px rgba(0,0,0,0.55)",
        maxWidth: "400px",
        width: "100%",
      }}>

        {/* Front / Back toggle */}
        <div style={{
          display: "flex",
          background: "#e0e0e0",
          borderRadius: "30px",
          padding: "3px",
          gap: "2px",
        }}>
          {["front", "back"].map((v) => (
            <button
              key={v}
              onClick={() => setView(v)}
              style={{
                padding: "7px 22px",
                borderRadius: "30px",
                border: "none",
                cursor: "pointer",
                fontSize: "12px",
                fontWeight: "700",
                letterSpacing: "1px",
                textTransform: "uppercase",
                transition: "all 0.15s ease",
                background: view === v ? "#e91e8c" : "transparent",
                color: view === v ? "#fff" : "#888",
                boxShadow: view === v ? "0 2px 8px rgba(233,30,140,0.35)" : "none",
              }}
            >
              {v}
            </button>
          ))}
        </div>

        {/* Shirt display */}
        <div style={{
          position: "relative",
          width: "320px",
          height: "320px",
          isolation: "isolate",
        }}>
          {/* White shirt base */}
          <img
            src={activeShirt}
            alt={`shirt ${view}`}
            style={{
              position: "absolute",
              inset: 0,
              width: "100%",
              height: "100%",
              objectFit: "contain",
              display: "block",
            }}
          />

          {/* Color tint — masked to shirt shape only */}
          <div style={{
            position: "absolute",
            inset: 0,
            backgroundColor: selectedColor.hex,
            maskImage: `url(${activeShirt})`,
            WebkitMaskImage: `url(${activeShirt})`,
            maskSize: "contain",
            WebkitMaskSize: "contain",
            maskRepeat: "no-repeat",
            WebkitMaskRepeat: "no-repeat",
            maskPosition: "center",
            WebkitMaskPosition: "center",
            mixBlendMode: "multiply",
          }} />

          {/* Graphic — front only */}
          {graphic && view === "front" && (
            <div style={{
              position: "absolute",
              top: "38%",
              left: "50%",
              transform: "translate(-50%, -50%)",
              width: "38%",
              pointerEvents: "none",
            }}>
              <img
                src={graphic}
                alt="custom design"
                style={{ width: "100%", height: "auto", objectFit: "contain" }}
              />
            </div>
          )}
        </div>

        {/* Color label */}
        <div style={{ display: "flex", alignItems: "center", gap: "10px" }}>
          <div style={{
            width: "18px",
            height: "18px",
            borderRadius: "50%",
            background: selectedColor.hex,
            border: "2px solid #bbb",
            flexShrink: 0,
          }} />
          <span style={{ fontWeight: "700", fontSize: "14px", color: "#222", letterSpacing: "0.5px" }}>
            {selectedColor.name}
          </span>
        </div>

        {/* Color swatches */}
        <div style={{ display: "flex", flexWrap: "wrap", gap: "10px", justifyContent: "center" }}>
          {COLORS.map((color) => (
            <button
              key={color.hex}
              onClick={() => setSelectedColor(color)}
              title={color.name}
              style={{
                width: "34px",
                height: "34px",
                borderRadius: "50%",
                background: color.hex,
                border: selectedColor.hex === color.hex
                  ? "3px solid #e91e8c"
                  : color.hex === "#ffffff" ? "2px solid #bbb" : "2px solid #ccc",
                cursor: "pointer",
                boxShadow: selectedColor.hex === color.hex
                  ? "0 0 0 2px #f0f0f0, 0 0 0 4px #e91e8c"
                  : "0 2px 4px rgba(0,0,0,0.2)",
                transition: "all 0.15s ease",
                outline: "none",
                flexShrink: 0,
              }}
            />
          ))}
        </div>

        {/* Upload button */}
        <input
          ref={fileInputRef}
          type="file"
          accept="image/*"
          onChange={handleUpload}
          style={{ display: "none" }}
        />
        <button
          onClick={() => fileInputRef.current.click()}
          style={{
            marginTop: "4px",
            padding: "10px 24px",
            background: "#e91e8c",
            color: "#fff",
            border: "none",
            borderRadius: "30px",
            fontSize: "13px",
            fontWeight: "700",
            letterSpacing: "1px",
            cursor: "pointer",
            textTransform: "uppercase",
            boxShadow: "0 4px 14px rgba(233,30,140,0.4)",
            transition: "opacity 0.15s ease",
          }}
        >
          {graphic ? "Change Graphic" : "Upload Graphic"}
        </button>

        {graphic && (
          <button
            onClick={() => setGraphic(null)}
            style={{
              padding: "6px 16px",
              background: "transparent",
              color: "#999",
              border: "1px solid #ccc",
              borderRadius: "30px",
              fontSize: "11px",
              cursor: "pointer",
              marginTop: "-10px",
            }}
          >
            Remove Graphic
          </button>
        )}
      </div>
    </div>
  );
}
