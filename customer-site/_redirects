# Under Pressure Custom Apparel — Cloudflare Pages _redirects
# Place this file in customer-site/ (repo root for this Pages project)

# ── Root URL serves the store ────────────────────────────────────────
/                /customer-index.html              200
/store           /customer-index.html              200

# ── Dynamic team store renderer ──────────────────────────────────────
# Rewrites /team-store?team=anything to team-store.html
# Query string passes through automatically — no per-store lines needed.
/team-store      /team-store.html                  200

# ── Legacy named routes (kept for old links) ─────────────────────────
/rampage         /team-store.html?team=rampage      200
/rome            /team-store.html?team=rome         200
